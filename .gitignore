# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/web/.next/
/out/
/web/out/

# production
/build
/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mutation testing
reports/
.stryker-tmp/

# agent tooling: installed skills (symlinked) and local session settings.
# skills-lock.json IS committed so the skill set can be reinstalled.
.agents/
.claude/

# sync layer: local SQLite database (src/lib/sync/sqlite-store.ts)
/.data/
