{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terrarium Companion",
  "version": "0.1.0",
  "identifier": "com.terrarium.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node scripts/sync-core.mjs",
    "beforeBuildCommand": "node scripts/sync-core.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Terrarium",
        "width": 800,
        "height": 150,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://raw.githubusercontent.com data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
