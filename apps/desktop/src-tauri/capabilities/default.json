{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The companion window: events from the tray, click-through, and cursor position for hit-testing.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-cursor-position",
    "core:window:allow-set-focus"
  ]
}
