# GitHub personal access token used by apps/web/src/lib/game/github.ts to fetch
# commit activity for the creature's XP. Optional: unauthenticated requests
# still work, but only through the REST public-events fallback, which
# undercounts real commit activity by roughly 10x (GitHub's PushEvent
# payloads no longer reliably carry a per-push commit count). With a token,
# the build uses the GraphQL contributions path instead, which returns real
# per-day commit counts, plus a higher rate limit (5,000/hour instead of 60).
# No scopes are required since only public data is read.
#
# Never commit a real token. This file is the template; your real value goes
# in apps/web/.env.local (already gitignored via the `.env*` rule) or in your CI/host
# provider's secret store.
GITHUB_TOKEN=

# The GitHub handle treated as "the owner" by apps/web/src/app/api/creature/route.ts
# and apps/web/src/app/api/creature.svg/route.ts. Only this handle gets its real
# local garden stats (notes, backlinks, tags); every other handle queried
# through the API gets a creature built from zeroed garden stats plus that
# handle's own public commit activity. Optional, but without it every
# request to the API is treated as a non-owner, including your own.
GITHUB_LOGIN=

# --- Sign in with GitHub -----------------------------------------------------
# The three variables below gate sync, public profiles, and the leaderboard.
# They work as a set: with any one of them missing, `getSessionProvider()` in
# apps/web/src/lib/sync/session.ts resolves to always-signed-out and the sign in control
# hides itself, rather than offering a button that cannot work. That is the
# correct state for a checkout that has never registered an app, not an error.
#
# These come from a GitHub App (Settings, Developer settings, GitHub Apps),
# not an OAuth App. Either protocol logs a user in, but a GitHub App accepts
# several callback URLs, so http://localhost:3000/api/auth/callback and the
# deployed callback can coexist without re-registering. The app needs no
# repository, organization, or account permissions: identity comes back from
# GET /user on a bare user token, and everything else this product reads is
# public. Set "Where can this GitHub App be installed" to "Any account", or
# nobody but you will ever be able to sign in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HMAC key for the signed session cookie (apps/web/src/lib/sync/session-cookie.ts).
# Must be at least 32 characters; anything shorter is treated as absent and
# degrades the site to signed-out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every existing session, which is the
# intended lever if a secret ever leaks.
SESSION_SECRET=

# Public origin used to build the OAuth callback URL. Optional, and normally
# omitted: the callback is derived from the request's own origin, so localhost
# and the deployed site both work with no configuration. Set it only when the
# origin lies, which happens behind a proxy or tunnel that terminates TLS and
# leaves the app seeing http://internal:3000 while the browser saw HTTPS. The
# value must match a registered callback byte for byte, without a trailing
# slash. Example: https://your-domain.com
AUTH_BASE_URL=

# --- Sync storage ------------------------------------------------------------
# Where the local SQLite sync database lives (apps/web/src/lib/sync/sqlite-store.ts).
# Optional: defaults to ./.data/sync.db, which is gitignored. Under Vitest an
# in-memory database is used instead, so tests never touch the dev database.
# Note this path is only meaningful for the SQLite store, which needs a real
# writable disk; a serverless deployment needs a different SyncStore adapter.
SYNC_DB_PATH=
