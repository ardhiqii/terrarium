# GitHub personal access token used by src/lib/game/github.ts to fetch
# commit activity for the creature's XP. Optional: unauthenticated requests
# still work, but only through the REST public-events fallback, which
# undercounts real commit activity by roughly 10x (GitHub's PushEvent
# payloads no longer reliably carry a per-push commit count). With a token,
# the build uses the GraphQL contributions path instead, which returns real
# per-day commit counts, plus a higher rate limit (5,000/hour instead of 60).
# No scopes are required since only public data is read.
#
# Never commit a real token. This file is the template; your real value goes
# in .env.local (already gitignored via the `.env*` rule) or in your CI/host
# provider's secret store.
GITHUB_TOKEN=

# The GitHub handle treated as "the owner" by src/app/api/creature/route.ts
# and src/app/api/creature.svg/route.ts. Only this handle gets its real
# local garden stats (notes, backlinks, tags); every other handle queried
# through the API gets a creature built from zeroed garden stats plus that
# handle's own public commit activity. Optional, but without it every
# request to the API is treated as a non-owner, including your own.
GITHUB_LOGIN=
